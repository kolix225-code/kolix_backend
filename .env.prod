# ==============================================================================
# Environnement PRODUCTION (Docker Compose Deploy)
# Fichier : .env.prod
# IMPORTANT : Ne jamais committer ce fichier avec des clés réelles dans un dépôt public !
# ==============================================================================

ENVIRONMENT=production
PROJECT_NAME="Kolix Production API"
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=false

# Sécurité & JWT (Générer avec: openssl rand -hex 32)
SECRET_KEY=REPLACE_WITH_OPENSSL_HEX_64_CHARACTERS_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_MINUTES=5

# PostgreSQL Haute Disponibilité / RDS / Managed Database
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=kolix_prod_admin
POSTGRES_PASSWORD=REPLACE_WITH_VERY_STRONG_DB_PASSWORD
POSTGRES_DB=kolix_production
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=15
DATABASE_TIMEOUT_SECONDS=20

# Redis Cluster / Managed Redis (Cache, Sessions & Arq Workers)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_DB=0

# Object Storage AWS S3 / Cloudflare R2
S3_ENDPOINT_URL=https://s3.eu-west-3.amazonaws.com
S3_ACCESS_KEY=AKIA_PROD_ACCESS_KEY
S3_SECRET_KEY=PROD_SECRET_KEY_AWS
S3_BUCKET_NAME=kolix-media-production
S3_REGION=eu-west-3
S3_PUBLIC_DOMAIN=https://media.kolix.ci

# Automatisation en production
SKIP_MIGRATIONS=false
AUTO_SEED=false

# WhatsApp Cloud API Officielle Meta
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=PROD_META_PHONE_ID
WHATSAPP_ACCESS_TOKEN=PROD_META_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=PROD_WEBHOOK_VERIFY_TOKEN

# Passerelles Mobile Money Production
WAVE_API_KEY=wave_ci_prod_live_key
WAVE_WEBHOOK_SECRET=wave_prod_whsec_live
ORANGE_MONEY_CLIENT_ID=om_prod_client_id
ORANGE_MONEY_CLIENT_SECRET=om_prod_client_secret

# Brevo (Sendinblue) Transactional Email & OTP
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@kolix.ci
BREVO_SENDER_NAME=Kolix

# IA & LLM
GEMINI_API_KEY=AIzaSy_PROD_GEMINI_API_KEY
DEFAULT_LLM_MODEL=gemini/gemini-1.5-flash

