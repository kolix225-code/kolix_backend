# ==============================================================================
# Environnement DÉVELOPPEMENT LOCAL (Docker Compose)
# Fichier : .env.dev
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="Kolix Backend API (Dev Docker)"
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=true

# Sécurité & JWT (Clé de développement)
SECRET_KEY=dev_secret_key_kolix_2026_super_secure_hex_key_for_local_testing_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_MINUTES=5

# PostgreSQL Conteneurisé (service 'db')
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=kolix_admin
POSTGRES_PASSWORD=kolix_secure_pass_2026
POSTGRES_DB=kolix_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_TIMEOUT_SECONDS=30

# Redis Conteneurisé (service 'redis')
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO Conteneurisé (service 'minio')
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio_kolix
S3_SECRET_KEY=minio_kolix_secure_key
S3_BUCKET_NAME=kolix-media
S3_REGION=eu-west-3
S3_PUBLIC_DOMAIN=http://localhost:9000/kolix-media

# Automatisation au démarrage du conteneur
SKIP_MIGRATIONS=false
AUTO_SEED=true

# WhatsApp & Mobile Money (Mode simulation en dev)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=kolix_wa_webhook_verify_secret

WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# Brevo (Sendinblue) Transactional Email & OTP
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@kolix.ci
BREVO_SENDER_NAME=Kolix

# IA & LLM
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-1.5-flash

