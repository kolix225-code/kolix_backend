# ==============================================================================
# CONFIGURATION ENVIRONNEMENT - KOLIX BACKEND
# ==============================================================================

# Environnement (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Kolix Backend API"
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=true

# Sécurité & JWT (Générez une clé aléatoire en production)
SECRET_KEY=9a2b8e3d04cfb219e489c6d3fa716f9a08e1a681c3bcfa237e8db46324fa6821
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_MINUTES=5

# ==============================================================================
# BASE DE DONNÉES SUPABASE (PostgreSQL Cloud)
# ==============================================================================
# Connect to Postgres via the shared transaction-mode pooler (IPv4 - Port 6543)
DATABASE_URL="postgresql://postgres.huyngghpmcscvvhyhjln:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations - Port 5432)
DIRECT_URL="postgresql://postgres.huyngghpmcscvvhyhjln:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# ==============================================================================
# BASE DE DONNÉES POSTGRESQL LOCALE (Alternative sans Supabase)
# ==============================================================================
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=soum
POSTGRES_DB=kolix_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_TIMEOUT_SECONDS=30

# Redis Cache & Queues (Optionnel en local)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minio_kolix
S3_SECRET_KEY=minio_kolix_secure_key
S3_BUCKET_NAME=kolix-media
S3_REGION=eu-west-3
S3_PUBLIC_DOMAIN=http://127.0.0.1:9000/kolix-media

# WhatsApp Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=kolix_wa_webhook_verify_secret

# Brevo (Sendinblue) Transactional Email & OTP
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@kolix.ci
BREVO_SENDER_NAME=Kolix

# Passerelles Mobile Money
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# IA & LLM
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-1.5-flash

