# ==============================================================================
# Environnement PRÉ-PRODUCTION / STAGING (Docker Compose)
# Fichier : .env.preprod
# ==============================================================================

ENVIRONMENT=staging
PROJECT_NAME="Kolix Backend API (Staging)"
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=false

# Sécurité & JWT (Générer une clé cryptographique unique par environnement)
SECRET_KEY=preprod_secret_84f93b01859c0498a3b8417c80081d9f04c6a9b401209bca74e0d9b1a03e1b02
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5

# PostgreSQL Staging (Conteneur ou RDS Staging)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=kolix_preprod_user
POSTGRES_PASSWORD=kolix_preprod_strong_password_2026
POSTGRES_DB=kolix_preprod_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_TIMEOUT_SECONDS=30

# Redis Staging
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=kolix_redis_preprod_secret
REDIS_DB=0

# Object Storage S3 Staging (MinIO ou Bucket AWS/Wasabi Staging)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=preprod_minio_key
S3_SECRET_KEY=preprod_minio_ultra_secure_secret
S3_BUCKET_NAME=kolix-preprod-media
S3_REGION=eu-west-3
S3_PUBLIC_DOMAIN=https://media-staging.kolix.ci

# Automatisation au démarrage du conteneur
SKIP_MIGRATIONS=false
AUTO_SEED=true

# WhatsApp Cloud API (Test number Meta Sandbox)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=1092837465928
WHATSAPP_ACCESS_TOKEN=EAAG_test_staging_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=kolix_staging_webhook_secret

# Passerelles Mobile Money (Sandbox Wave / Orange Money)
WAVE_API_KEY=wave_ci_test_key_staging
WAVE_WEBHOOK_SECRET=wave_whsec_test_staging
ORANGE_MONEY_CLIENT_ID=om_test_client_id
ORANGE_MONEY_CLIENT_SECRET=om_test_secret

# IA & LLM
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-1.5-flash

